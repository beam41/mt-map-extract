<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mt-parts</AssemblyName>
    <RootNamespace>Parts</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Reuse the main extractor's mounting/localization helpers, linked in from the repo root. -->
  <ItemGroup>
    <Compile Include="../AssetSource.cs" Link="Shared/AssetSource.cs" />
    <Compile Include="../Options.cs" Link="Shared/Options.cs" />
    <Compile Include="../Localization.cs" Link="Shared/Localization.cs" />
    <Compile Include="../CargoKeys.cs" Link="Shared/CargoKeys.cs" />
  </ItemGroup>

</Project>
