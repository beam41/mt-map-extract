<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mt-extract</AssemblyName>
    <RootNamespace>MtExtract</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

      <!-- richtags/, tools/ and wiki/ are standalone projects with their own csprojs; keep their
           sources and generated obj/bin out of this project's default compile glob. -->
      <ItemGroup>
        <Compile Remove="richtags/**" />
        <Compile Remove="tools/**" />
        <Compile Remove="wiki/**" />
        <EmbeddedResource Remove="richtags/**" />
        <EmbeddedResource Remove="tools/**" />
        <EmbeddedResource Remove="wiki/**" />
        <None Remove="richtags/**" />
        <None Remove="tools/**" />
        <None Remove="wiki/**" />
        <Content Remove="richtags/**" />
        <Content Remove="tools/**" />
        <Content Remove="wiki/**" />
      </ItemGroup>

      <ItemGroup>
        <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202607" />
    <!-- SkiaSharp encodes the map png, libvips slices it into tiles (heifsave gives us AVIF).
         SkiaSharp carries its own Windows/macOS binaries but needs the Linux ones added;
         NetVips.Native is the meta package that brings libvips for every runtime. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native" Version="8.18.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
