<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>heightmap</AssemblyName>
    <RootNamespace>HeightmapExtractor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../common/common.csproj" />
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Resizes the stitched heightmap to the requested resolution and saves 16-bit (real
         elevation data) + 8-bit normalized preview PNGs; same libvips setup as amc-web. -->
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native" Version="8.18.4" />
  </ItemGroup>

</Project>
